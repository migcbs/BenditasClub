generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  cliente
  empleado
  cocina
  admin
}

enum SucursalNombre {
  xico
  coatepec
}

enum TipoPedido {
  mesa
  para_llevar
  domicilio
}

enum EstadoPedido {
  pendiente
  pagado
  cancelado
}

enum EstadoEliminacion {
  ninguna
  pendiente
  aprobada
  rechazada
}

enum MetodoPago {
  tarjeta
  efectivo
  transferencia
}

enum EstadoCocina {
  nueva
  en_preparacion
  lista
  entregada
}

enum OrigenPedido {
  pos
  online
}

enum ProductTipo {
  comida
  merch
}

enum MerchEntrega {
  recoger
  domicilio
}

enum InventoryMovementType {
  purchase
  sale
  waste
  adjustment
  transfer_in
  transfer_out
}

enum PurchaseOrderStatus {
  draft
  ordered
  partial
  received
  cancelled
}

enum CashShiftStatus {
  open
  closed
}

enum CashMovementType {
  pay_in
  pay_out
}

model User {
  id   String @id @default(uuid())
  role Role   @default(cliente)

  // clientes
  email           String?   @unique
  password        String?
  telefono        String?
  fechaNacimiento DateTime?

  // staff (empleado/cocina)
  pin      String?
  sucursal SucursalNombre?

  nombre    String
  activo    Boolean  @default(true)
  staffOrders    Order[] @relation("StaffOrders")
  customerOrders Order[] @relation("CustomerOrders")
  merchOrders    MerchOrder[] @relation("CustomerMerchOrders")
  loyaltyCard    LoyaltyCard?
  loyaltyRedemptions LoyaltyRedemption[] @relation("CustomerRedemptions")
  pointsRedemptions  PointsRedemption[]
  birthdayRedemptions BirthdayRedemption[]
  addresses      Address[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id       String    @id @default(uuid())
  nombre   String    @unique
  orden    Int       @default(0)
  products Product[]
}

model Product {
  id          String      @id @default(uuid())
  nombre      String
  precio      Int
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tipo        ProductTipo @default(comida)
  imagenUrl   String?
  maxSabores  Int?
  isPromotion Boolean     @default(false)
  activo      Boolean     @default(true)
  // null = no canjeable por puntos. Si tiene valor, el cliente lo puede
  // cambiar por sus puntos acumulados en cuanto junte esta cantidad — sin
  // un mínimo genérico aparte, ver PointsRedemption.
  costoPuntos Int?
  orderItems  OrderItem[]
  recipe      Recipe?
  variants    ProductVariant[]
  loyaltyRewards LoyaltyReward[]
  birthdayRewards BirthdayReward[]
  pointsRedemptions PointsRedemption[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  nombre    String
  precio    Int
  imagenUrl String?
  sku       String?
  activo    Boolean  @default(true)
  orden     Int      @default(0)
  stocks    VariantStock[]
  merchOrderItems MerchOrderItem[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VariantStock {
  id        String         @id @default(uuid())
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  sucursal  SucursalNombre
  quantity  Int            @default(0)
  updatedAt DateTime       @updatedAt

  @@unique([variantId, sucursal])
}

model MerchOrder {
  id              String         @id @default(uuid())
  sucursal        SucursalNombre
  tipoEntrega     MerchEntrega   @default(recoger)
  estado          EstadoPedido   @default(pendiente)
  clienteId       String?
  cliente         User?          @relation("CustomerMerchOrders", fields: [clienteId], references: [id])
  clienteNombre   String?
  clienteTelefono String?
  direccion       String?
  notas           String?
  total           Int
  items           MerchOrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model MerchOrderItem {
  id             String         @id @default(uuid())
  orderId        String
  order          MerchOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId      String
  variant        ProductVariant @relation(fields: [variantId], references: [id])
  nombre         String
  varianteNombre String
  precio         Int
  cantidad       Int
  subtotal       Int
}

// Direcciones guardadas del cliente para pedidos a domicilio — puede tener
// varias (casa, trabajo, etc.) y elegir cuál usar al pedir, en vez de un
// solo campo `direccion` fijo en User.
model Address {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  etiqueta    String?
  direccion   String
  esPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// Datos bancarios por sucursal para pedidos pagados por transferencia — el
// admin los edita, y el popup de "Confirmar pedido" los muestra al cliente
// según a qué sucursal está pidiendo.
model BranchSettings {
  sucursal  SucursalNombre @id
  clabe     String?
  banco     String?
  titular   String?
  updatedAt DateTime       @updatedAt
}

// Sin correo saliente configurado: el cliente pide el restablecimiento
// aquí, el admin lo ve en Configuración y cambia la contraseña a mano,
// y el seguimiento real pasa por WhatsApp (ver mensaje en el popup del
// cliente). customerId no es una relación de Prisma a propósito — solo
// un id de referencia para que el admin pueda ubicar la cuenta, sin
// forzar integridad referencial sobre User por una feature tan simple.
model PasswordResetRequest {
  id           String    @id @default(uuid())
  email        String
  nombre       String?
  telefono     String?
  customerId   String?
  estado       String    @default("pendiente")
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  resolvedById String?
}

model Order {
  id                  String         @id @default(uuid())
  sucursal            SucursalNombre
  tipo                TipoPedido
  estado              EstadoPedido   @default(pendiente)
  estadoCocina        EstadoCocina   @default(nueva)
  origen              OrigenPedido   @default(pos)
  recibidoEn          DateTime?
  motivoRechazo       String?
  metodoPago          MetodoPago?
  mesa                String?
  clienteNombre       String?
  clienteTelefono     String?
  clienteId           String?
  cliente             User?          @relation("CustomerOrders", fields: [clienteId], references: [id])
  direccion           String?
  notas               String?
  total               Int
  empleadoId          String?
  empleado            User?          @relation("StaffOrders", fields: [empleadoId], references: [id])
  items               OrderItem[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  inventoryAppliedAt  DateTime?
  inventoryRevertedAt DateTime?

  // Nunca se borra la fila de verdad — para que "se contabilice todo". El
  // mesero solo puede solicitar con motivo; el admin aprueba (cancela la
  // venta) o rechaza (queda como si nada), o elimina directo sin pasar por
  // una solicitud.
  eliminacionEstado        EstadoEliminacion @default(ninguna)
  eliminacionMotivo        String?
  eliminacionSolicitadaPorId String?
  eliminacionSolicitadaAt  DateTime?
  eliminacionResueltaPorId String?
  eliminacionResueltaAt    DateTime?
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  nombre    String
  precio    Int
  cantidad  Int
  sabores   String[]
  subtotal  Int
}

model Ingredient {
  id            String              @id @default(uuid())
  nombre        String              @unique
  sku           String?             @unique
  unit          String
  costPerUnit   Decimal             @default(0) @db.Decimal(12, 4)
  reorderPoint  Decimal             @default(0) @db.Decimal(12, 4)
  activo        Boolean             @default(true)
  stocks        LocationStock[]
  recipeItems   RecipeItem[]
  movements     InventoryMovement[]
  purchaseItems PurchaseOrderItem[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model LocationStock {
  id           String         @id @default(uuid())
  ingredientId String
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  sucursal     SucursalNombre
  quantity     Decimal        @default(0) @db.Decimal(12, 4)
  updatedAt    DateTime       @updatedAt

  @@unique([ingredientId, sucursal])
}

model Recipe {
  id        String       @id @default(uuid())
  productId String       @unique
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  yield     Decimal      @default(1) @db.Decimal(12, 4)
  items     RecipeItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model RecipeItem {
  id           String     @id @default(uuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal    @db.Decimal(12, 4)

  @@unique([recipeId, ingredientId])
}

model InventoryMovement {
  id           String                @id @default(uuid())
  ingredientId String
  ingredient   Ingredient            @relation(fields: [ingredientId], references: [id])
  sucursal     SucursalNombre
  type         InventoryMovementType
  quantity     Decimal               @db.Decimal(12, 4)
  reason       String?
  referenceId  String?
  createdById  String?
  createdAt    DateTime              @default(now())
}

model Supplier {
  id             String          @id @default(uuid())
  nombre         String
  contacto       String?
  telefono       String?
  email          String?
  paymentTerms   String?
  activo         Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  sucursal    SucursalNombre
  status      PurchaseOrderStatus @default(draft)
  orderedAt   DateTime?
  receivedAt  DateTime?
  invoiceRef  String?
  notes       String?
  total       Decimal             @default(0) @db.Decimal(12, 2)
  createdById String?
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId     String
  ingredient       Ingredient    @relation(fields: [ingredientId], references: [id])
  quantityOrdered  Decimal       @db.Decimal(12, 4)
  quantityReceived Decimal       @default(0) @db.Decimal(12, 4)
  unitCost         Decimal       @db.Decimal(12, 4)
}

model CashShift {
  id             String          @id @default(uuid())
  sucursal       SucursalNombre
  status         CashShiftStatus @default(open)
  openingAmount  Decimal         @db.Decimal(12, 2)
  countedAmount  Decimal?        @db.Decimal(12, 2)
  expectedAmount Decimal?        @db.Decimal(12, 2)
  difference     Decimal?        @db.Decimal(12, 2)
  openedById     String
  closedById     String?
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  notes          String?
  movements      CashMovement[]
}

model CashMovement {
  id          String           @id @default(uuid())
  cashShiftId String
  cashShift   CashShift        @relation(fields: [cashShiftId], references: [id], onDelete: Cascade)
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  concept     String
  createdById String
  createdAt   DateTime         @default(now())
}

model Expense {
  id            String         @id @default(uuid())
  sucursal      SucursalNombre
  category      String
  concept       String
  amount        Decimal        @db.Decimal(12, 2)
  paymentMethod MetodoPago
  supplierId    String?
  receiptRef    String?
  occurredAt    DateTime       @default(now())
  createdById   String
  createdAt     DateTime       @default(now())
}

// ─────────────────────────────────────────────────────────────
// Tarjeta de fidelidad — 1 sello por pedido pagado y ligado a una
// cuenta de cliente; al llegar a stampsRequired se genera un canje con
// la recompensa activa en ese momento y la tarjeta reinicia en 0.
// ─────────────────────────────────────────────────────────────

enum LoyaltyRewardType {
  discount_percent
  discount_fixed
  free_item
  free_shipping
}

model LoyaltyReward {
  id             String              @id @default(uuid())
  label          String
  type           LoyaltyRewardType
  value          Int?
  productId      String?
  product        Product?            @relation(fields: [productId], references: [id])
  stampsRequired Int                 @default(6)
  minOrderAmount Int                 @default(0)
  activo         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  redemptions    LoyaltyRedemption[]
}

// Promoción de cumpleaños — mismo tipo de recompensa que LoyaltyReward
// (descuento/producto gratis) pero se desbloquea por fecha de nacimiento,
// no por sellos. Solo una activa a la vez, igual que las de sellos.
model BirthdayReward {
  id          String              @id @default(uuid())
  label       String
  type        LoyaltyRewardType
  value       Int?
  productId   String?
  product     Product?            @relation(fields: [productId], references: [id])
  activo      Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  redemptions BirthdayRedemption[]
}

// Un cliente solo puede reclamar la promo de cumpleaños una vez por año —
// se marca con el año calendario en el que se reclamó.
model BirthdayRedemption {
  id         String         @id @default(uuid())
  customerId String
  customer   User           @relation(fields: [customerId], references: [id])
  rewardId   String
  reward     BirthdayReward @relation(fields: [rewardId], references: [id])
  year       Int
  code       String         @unique
  redeemed   Boolean        @default(false)
  redeemedAt DateTime?
  createdAt  DateTime       @default(now())

  @@unique([customerId, year])
}

model LoyaltyCard {
  id         String   @id @default(uuid())
  customerId String   @unique
  customer   User     @relation(fields: [customerId], references: [id])
  stamps     Int      @default(0)
  // 2% del total de cada pedido pagado — independiente de los sellos, se
  // acumula siempre (con o sin recompensa activa) y se canjea por
  // separado, ver PointsRedemption.
  puntos     Decimal  @default(0) @db.Decimal(10, 2)
  updatedAt  DateTime @updatedAt
}

// Canje de puntos acumulados (no de sellos) — el cliente "cobra" su saldo
// completo, se le da un código para mostrar en sucursal, y el staff decide
// ahí qué producto le da a cambio (no hay un catálogo de precios en puntos
// todavía, solo el mínimo para poder canjear).
// Canje por un producto específico (no un monto libre) — se descuenta
// costoPuntos del saldo del cliente, no todo su balance.
model PointsRedemption {
  id         String    @id @default(uuid())
  customerId String
  customer   User      @relation(fields: [customerId], references: [id])
  productId  String?
  product    Product?  @relation(fields: [productId], references: [id])
  puntos     Decimal   @db.Decimal(10, 2)
  code       String    @unique
  redeemed   Boolean   @default(false)
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())
}

model LoyaltyRedemption {
  id         String    @id @default(uuid())
  customerId String
  customer   User      @relation("CustomerRedemptions", fields: [customerId], references: [id])
  rewardId   String
  reward     LoyaltyReward @relation(fields: [rewardId], references: [id])
  code       String    @unique
  redeemed   Boolean   @default(false)
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())
}
