generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  cliente
  empleado
  cocina
  admin
}

enum SucursalNombre {
  xico
  coatepec
}

enum TipoPedido {
  mesa
  para_llevar
  domicilio
}

enum EstadoPedido {
  pendiente
  pagado
  cancelado
}

enum MetodoPago {
  tarjeta
  efectivo
}

enum EstadoCocina {
  nueva
  en_preparacion
  lista
  entregada
}

enum OrigenPedido {
  pos
  online
}

enum InventoryMovementType {
  purchase
  sale
  waste
  adjustment
  transfer_in
  transfer_out
}

enum PurchaseOrderStatus {
  draft
  ordered
  partial
  received
  cancelled
}

enum CashShiftStatus {
  open
  closed
}

enum CashMovementType {
  pay_in
  pay_out
}

model User {
  id   String @id @default(uuid())
  role Role   @default(cliente)

  // clientes
  email    String? @unique
  password String?
  telefono String?

  // staff (empleado/cocina)
  pin      String?
  sucursal SucursalNombre?

  nombre    String
  activo    Boolean  @default(true)
  staffOrders    Order[] @relation("StaffOrders")
  customerOrders Order[] @relation("CustomerOrders")
  loyaltyCard    LoyaltyCard?
  loyaltyRedemptions LoyaltyRedemption[] @relation("CustomerRedemptions")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id       String    @id @default(uuid())
  nombre   String    @unique
  orden    Int       @default(0)
  products Product[]
}

model Product {
  id          String      @id @default(uuid())
  nombre      String
  precio      Int
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  maxSabores  Int?
  isPromotion Boolean     @default(false)
  activo      Boolean     @default(true)
  orderItems  OrderItem[]
  recipe      Recipe?
  loyaltyRewards LoyaltyReward[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id                  String         @id @default(uuid())
  sucursal            SucursalNombre
  tipo                TipoPedido
  estado              EstadoPedido   @default(pendiente)
  estadoCocina        EstadoCocina   @default(nueva)
  origen              OrigenPedido   @default(pos)
  recibidoEn          DateTime?
  motivoRechazo       String?
  metodoPago          MetodoPago?
  mesa                String?
  clienteNombre       String?
  clienteTelefono     String?
  clienteId           String?
  cliente             User?          @relation("CustomerOrders", fields: [clienteId], references: [id])
  direccion           String?
  notas               String?
  total               Int
  empleadoId          String?
  empleado            User?          @relation("StaffOrders", fields: [empleadoId], references: [id])
  items               OrderItem[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  inventoryAppliedAt  DateTime?
  inventoryRevertedAt DateTime?
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  nombre    String
  precio    Int
  cantidad  Int
  sabores   String[]
  subtotal  Int
}

model Ingredient {
  id            String              @id @default(uuid())
  nombre        String              @unique
  sku           String?             @unique
  unit          String
  costPerUnit   Decimal             @default(0) @db.Decimal(12, 4)
  reorderPoint  Decimal             @default(0) @db.Decimal(12, 4)
  activo        Boolean             @default(true)
  stocks        LocationStock[]
  recipeItems   RecipeItem[]
  movements     InventoryMovement[]
  purchaseItems PurchaseOrderItem[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model LocationStock {
  id           String         @id @default(uuid())
  ingredientId String
  ingredient   Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  sucursal     SucursalNombre
  quantity     Decimal        @default(0) @db.Decimal(12, 4)
  updatedAt    DateTime       @updatedAt

  @@unique([ingredientId, sucursal])
}

model Recipe {
  id        String       @id @default(uuid())
  productId String       @unique
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  yield     Decimal      @default(1) @db.Decimal(12, 4)
  items     RecipeItem[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model RecipeItem {
  id           String     @id @default(uuid())
  recipeId     String
  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  quantity     Decimal    @db.Decimal(12, 4)

  @@unique([recipeId, ingredientId])
}

model InventoryMovement {
  id           String                @id @default(uuid())
  ingredientId String
  ingredient   Ingredient            @relation(fields: [ingredientId], references: [id])
  sucursal     SucursalNombre
  type         InventoryMovementType
  quantity     Decimal               @db.Decimal(12, 4)
  reason       String?
  referenceId  String?
  createdById  String?
  createdAt    DateTime              @default(now())
}

model Supplier {
  id             String          @id @default(uuid())
  nombre         String
  contacto       String?
  telefono       String?
  email          String?
  paymentTerms   String?
  activo         Boolean         @default(true)
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PurchaseOrder {
  id          String              @id @default(uuid())
  supplierId  String
  supplier    Supplier            @relation(fields: [supplierId], references: [id])
  sucursal    SucursalNombre
  status      PurchaseOrderStatus @default(draft)
  orderedAt   DateTime?
  receivedAt  DateTime?
  invoiceRef  String?
  notes       String?
  total       Decimal             @default(0) @db.Decimal(12, 2)
  createdById String?
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model PurchaseOrderItem {
  id               String        @id @default(uuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredientId     String
  ingredient       Ingredient    @relation(fields: [ingredientId], references: [id])
  quantityOrdered  Decimal       @db.Decimal(12, 4)
  quantityReceived Decimal       @default(0) @db.Decimal(12, 4)
  unitCost         Decimal       @db.Decimal(12, 4)
}

model CashShift {
  id             String          @id @default(uuid())
  sucursal       SucursalNombre
  status         CashShiftStatus @default(open)
  openingAmount  Decimal         @db.Decimal(12, 2)
  countedAmount  Decimal?        @db.Decimal(12, 2)
  expectedAmount Decimal?        @db.Decimal(12, 2)
  difference     Decimal?        @db.Decimal(12, 2)
  openedById     String
  closedById     String?
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  notes          String?
  movements      CashMovement[]
}

model CashMovement {
  id          String           @id @default(uuid())
  cashShiftId String
  cashShift   CashShift        @relation(fields: [cashShiftId], references: [id], onDelete: Cascade)
  type        CashMovementType
  amount      Decimal          @db.Decimal(12, 2)
  concept     String
  createdById String
  createdAt   DateTime         @default(now())
}

model Expense {
  id            String         @id @default(uuid())
  sucursal      SucursalNombre
  category      String
  concept       String
  amount        Decimal        @db.Decimal(12, 2)
  paymentMethod MetodoPago
  supplierId    String?
  receiptRef    String?
  occurredAt    DateTime       @default(now())
  createdById   String
  createdAt     DateTime       @default(now())
}

// ─────────────────────────────────────────────────────────────
// Tarjeta de fidelidad — 1 sello por pedido pagado y ligado a una
// cuenta de cliente; al llegar a stampsRequired se genera un canje con
// la recompensa activa en ese momento y la tarjeta reinicia en 0.
// ─────────────────────────────────────────────────────────────

enum LoyaltyRewardType {
  discount_percent
  discount_fixed
  free_item
  free_shipping
}

model LoyaltyReward {
  id             String              @id @default(uuid())
  label          String
  type           LoyaltyRewardType
  value          Int?
  productId      String?
  product        Product?            @relation(fields: [productId], references: [id])
  stampsRequired Int                 @default(6)
  activo         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  redemptions    LoyaltyRedemption[]
}

model LoyaltyCard {
  id         String   @id @default(uuid())
  customerId String   @unique
  customer   User     @relation(fields: [customerId], references: [id])
  stamps     Int      @default(0)
  updatedAt  DateTime @updatedAt
}

model LoyaltyRedemption {
  id         String    @id @default(uuid())
  customerId String
  customer   User      @relation("CustomerRedemptions", fields: [customerId], references: [id])
  rewardId   String
  reward     LoyaltyReward @relation(fields: [rewardId], references: [id])
  code       String    @unique
  redeemed   Boolean   @default(false)
  redeemedAt DateTime?
  createdAt  DateTime  @default(now())
}
