fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-retries=5
# Sin esto, "npm install" en un entorno limpio (Vercel) falla con ERESOLVE:
# react-scripts pide typescript ^3/^4 pero algo (ej. @mui/material) jala
# una versión más nueva como peer opcional. El proyecto no usa TypeScript,
# así que resolver peers de forma laxa (como npm v6) es seguro aquí.
legacy-peer-deps=true